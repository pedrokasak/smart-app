# Resend
RESEND_API_KEY=""
RESEND_FROM=""
RESEND_AUDIENCE_ID=""

# Frontend
FRONTEND_URL=""

COOLIFY_WEBHOOK_URL=""

# Ranges que o plano atual do brapi serve. Ampliar aqui (sem mexer em código)
# quando o plano pago for contratado — os demais caem para o Yahoo Finance.
BRAPI_SUPPORTED_RANGES=1d,5d,1mo,3mo

# Secret próprio para os tokens de unsubscribe do digest de e-mail (TRA-17).
# Diferente de JWT_SECRET de propósito: um token de unsubscribe assinado com
# este secret é matematicamente incapaz de validar como access token.
DIGEST_TOKEN_SECRET=""

# URL interna do trackerr-ia (motor de IA/RAG). Deve apontar para a rede
# privada — este serviço não deve receber URL pública.
TRAKKER_IA_URL="http://localhost:8000"

# Segredo compartilhado com o trackerr-ia (TRA-89). O trackerr-ia autentica
# o server por este valor no header `x-service-token` e recusa qualquer
# requisição sem ele. Precisa ser idêntico ao TRACKERR_IA_SERVICE_TOKEN
# configurado lá. Gerar com: openssl rand -hex 32
TRACKERR_IA_SERVICE_TOKEN=""

# --- Stripe product/price mapping por plano canônico (TRA-18) ---
# Consumido pelo `PlanSyncService` (`src/subscription/plan-sync`) e pelo CLI
# `npm run sync:plans`. Um plano sem PRODUCT_ID / PRICE_MONTHLY_ID configurado
# fica sem vínculo mensal ao Stripe (o seed loga TODO — nunca inventa IDs).
# ANNUAL_AMOUNT é o valor cobrado ao ano em BRL e serve para exibição no
# `/subscription`; PRICE_ANNUAL_ID é o preço de fato usado no checkout anual.
#
# Mapa slug canônico -> produto no Stripe (confira antes de preencher, os IDs
# mudam entre a conta de teste e a de produção):
#   essencial -> "Gratuito"        R$ 0/mês
#   pro       -> "Investidor Pro"  R$ 14,90/mês · R$ 149,00/ano
#   premium   -> "Premium"         R$ 24,90/mês · R$ 249,00/ano
# Os valores acima precisam bater com `canonical-plans.config.ts`: o sync
# grava `monthlyPrice` no campo exibido na vitrine, enquanto quem cobra é o
# PRICE_MONTHLY_ID. Divergir publica um preço que o Stripe não cobra (TRA-150).
STRIPE_PLAN_PRO_PRODUCT_ID=""
STRIPE_PLAN_PRO_PRICE_MONTHLY_ID=""
STRIPE_PLAN_PRO_PRICE_ANNUAL_ID=""
STRIPE_PLAN_PRO_ANNUAL_AMOUNT=""
STRIPE_PLAN_PREMIUM_PRODUCT_ID=""
STRIPE_PLAN_PREMIUM_PRICE_MONTHLY_ID=""
STRIPE_PLAN_PREMIUM_PRICE_ANNUAL_ID=""
STRIPE_PLAN_PREMIUM_ANNUAL_AMOUNT=""
# `essencial` (gratuito) e `enterprise` (contact_sales) não são cobrados pelo
# Stripe, então não precisam de PRICE_*. O PRODUCT_ID existe só para quem
# quiser espelhar o plano no catálogo do Stripe; deixar vazio é o normal.
# Estavam faltando aqui embora `envKeysForSlug` já os gerasse (TRA-150).
STRIPE_PLAN_ESSENCIAL_PRODUCT_ID=""
STRIPE_PLAN_ENTERPRISE_PRODUCT_ID=""

# --- Barramento de eventos e fila duravel (TRA-136) ---
# O Redis roda como sidecar no compose (servico `redis`). Dentro da rede do
# compose o host e o nome do servico; fora dele, localhost.
#
# Publicar um evento NAO depende do Redis: o barramento in-process e
# sincrono e sem infra. O Redis serve ao trabalho pesado (e-mail, push,
# chamada ao trackerr-ia), que e enfileirado e executado pelo worker. Com o
# Redis fora do ar o request continua respondendo 2xx e a falha de
# enfileiramento vai para o log.
#
# REDIS_PASSWORD e lido tambem pelo docker-compose (`--requirepass`).
# Gerar com: openssl rand -hex 32
#
# ESTAS MESMAS VARIAVEIS servem ao contador do rate limit por endpoint
# (TRA-138), com chaves sob `trackerr:ratelimit:` — nao ha um segundo
# conjunto de variaveis para o mesmo Redis. Sem Redis (ou com
# EVENTS_QUEUE_ENABLED=false) o rate limit cai para um contador em memoria
# do processo, que so vale para UMA instancia: com varias, o limite efetivo
# vira `limite x instancias`.
REDIS_HOST="redis"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"

# Desliga a fila por completo (nenhuma conexao com Redis e aberta). Ausente
# = ligada. Ambiente de teste desliga sozinho.
EVENTS_QUEUE_ENABLED="true"

# Permite subir instancia que so publica (API) e instancia que so consome
# (worker) a partir da mesma imagem.
EVENTS_QUEUE_WORKER_ENABLED="true"

# Nome da fila. A dead-letter e derivada: `<nome>.dead-letter`.
EVENTS_QUEUE_NAME="trackerr.events"

# Dimensionado para o burst do cron diario com ~5 mil usuarios: jobs sao
# IO-bound (~200ms), entao 20 simultaneos dao ~100 jobs/s por instancia e
# drenam 5 mil jobs em ~50s.
EVENTS_QUEUE_CONCURRENCY="20"

# Retry exponencial: 5 tentativas a partir de 5s (5s, 10s, 20s, 40s).
# Esgotadas, o envelope vai para a dead-letter.
EVENTS_QUEUE_ATTEMPTS="5"
EVENTS_QUEUE_BACKOFF_MS="5000"

# Freio de emergencia para proteger o provedor de e-mail/push do burst.
# Folgado de proposito sobre os ~100 jobs/s da concorrencia.
EVENTS_QUEUE_RATE_LIMIT_MAX="200"
EVENTS_QUEUE_RATE_LIMIT_WINDOW_MS="1000"

# Retencao dos jobs concluidos. Define tambem a JANELA DE DEDUPLICACAO: o
# `jobId` (= `event.id`) so bloqueia um reenvio enquanto o job existir no
# Redis. 24h bate com DEDUPE_WINDOW_HOURS do NotificationsService.
EVENTS_QUEUE_KEEP_COMPLETED_SECONDS="86400"
EVENTS_QUEUE_KEEP_COMPLETED_COUNT="5000"

# Falhas ficam 7 dias — material de post-mortem na bull-board.
EVENTS_QUEUE_KEEP_FAILED_SECONDS="604800"

# Teto de espera do enfileiramento. Um Redis alcancavel mas travado nao
# devolve erro; sem este teto o request que publicou ficaria pendurado.
EVENTS_QUEUE_ENQUEUE_TIMEOUT_MS="2000"

# --- Motor de limiares (TRA-136, fase 4) ---------------------------------
# Defaults do sistema; cada usuario pode sobrescrever em User.thresholdPolicy.

# Banda de tolerancia da meta de alocacao, em pontos percentuais. Meta 30%
# com real 30,4% NAO e rompimento. Abaixo de ~0,5pp seria ruido de
# arredondamento do proprio produtor.
THRESHOLDS_ALLOCATION_BAND_PP="2"

# Queda de score de diversificacao (escala 0-100) que merece aviso. 10 e
# metade de uma faixa de classificacao (poor/moderate/good/excellent).
THRESHOLDS_SCORE_DROP_POINTS="10"

# Re-arme por tempo de uma condicao que continua verdadeira. Precisa ser
# MAIOR que DEDUPE_WINDOW_HOURS (24h) para nao se confundir com ele; 72h
# tambem cobre o fim de semana. 0 desliga o re-arme por tempo (so a volta
# para dentro da banda rearma).
THRESHOLDS_COOLDOWN_HOURS="72"

# --- Resumo IA da notificacao (TRA-136, fase 5) --------------------------
# Enriquecimento OPCIONAL: a notificacao determinista sai antes desta
# chamada e nao depende dela. 'false' desliga sem afetar o disparo.
NOTIFICATION_AI_SUMMARY_ENABLED="true"

# Teto de espera do trackerr-ia dentro do worker. Curto de proposito (a
# rota /ai/insights usa 30s): aqui ninguem esta esperando na tela, mas o job
# ocupa um slot de concorrencia da fila.
NOTIFICATION_AI_SUMMARY_TIMEOUT_MS="8000"

# --- Web Push / VAPID (TRA-136, fase 6) ----------------------------------
# Par de chaves do protocolo VAPID (RFC 8292), usado para assinar cada push
# enviado ao navegador. Gerar com:
#   npx web-push generate-vapid-keys
#
# AUSENTES = push desligado. O servidor sobe normalmente, as rotas de
# assinatura continuam respondendo e `GET /notifications/push/vapid-public-key`
# devolve string vazia — nada de 500 por falta de configuracao.
#
# A publica e servida ao front pela rota acima em vez de ir para o bundle:
# rotacionar a chave passa a ser variavel de ambiente, nao redeploy do web.
# A privada e segredo — nunca versionar, nunca logar.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# Contato exigido pela RFC 8292: e o endereco que o push service (Google,
# Mozilla, Microsoft) usa para reclamar de abuso. `mailto:` ou URL.
# Opcional — cai em mailto:contato@trackerr.app quando ausente.
VAPID_SUBJECT="mailto:contato@trackerr.app"

# --- Cifragem das credenciais de corretora (TRA-144) ---------------------
# Chave AES-256-GCM que protege apiKey / apiSecret / apiPassphrase das
# corretoras guardadas em `broker_connections`. Elas NAO podem virar hash: o
# servico precisa do valor original para assinar as chamadas a exchange.
#
# Gerar com:
#   openssl rand -hex 32
# (exatamente 64 caracteres hexadecimais = 32 bytes)
#
# AUSENTE = integracao com corretoras desligada. O servidor sobe, listar e
# desconectar continuam funcionando, e conectar/sincronizar respondem 503 com
# a mensagem de configuracao. NAO existe chave padrao: cifrar sob uma chave
# publicada no repositorio nao e cifrar.
#
# PRESENTE E MALFORMADA = o boot falha, de proposito. Quem definiu a variavel
# quer a feature ligada; desligar em silencio esconderia o engano.
#
# ROTACAO: trocar esta chave torna TODAS as credenciais ja guardadas
# indecifraveis. Nao ha migracao automatica — o usuario precisa reconectar a
# corretora (ou uma rotina de reescrita precisa rodar com a chave antiga
# disponivel antes da troca). Nunca versionar o valor real, nunca logar.
BROKER_ENCRYPTION_KEY=""

# Chave do formato ANTIGO (v1, AES-256-CBC), usada SOMENTE para ler linhas
# gravadas antes do TRA-144. O codigo antigo usava a string crua como bytes
# utf8, entao o valor aqui e a string original de 32 caracteres — nao hex.
#
# Deixe vazia se nao houver dados antigos. Se as credenciais foram gravadas
# com o fallback embutido no codigo, elas devem ser tratadas como COMPROMETIDAS:
# o certo e revoga-las na corretora e pedir que o usuario reconecte, nao
# migra-las. Remova esta variavel assim que a migracao terminar.
BROKER_ENCRYPTION_KEY_LEGACY=""

# --- Content Security Policy (TRK-009) -----------------------------------
# O CSP estava desligado. Ele e a defesa em profundidade que sobra quando uma
# injecao passa da validacao: sem ele, qualquer XSS futuro vale sessao
# inteira, porque nada impede o script de executar nem de exfiltrar para uma
# origem externa.
#
# AUSENTE (padrao) = REPORT-ONLY. O navegador reporta a violacao no console e
# NAO bloqueia nada. Subir direto em enforce e como times quebram
# funcionalidade legitima e depois desligam o CSP para sempre.
#
# "false" = ENFORCE. Promover e mudanca de configuracao, nao de codigo.
# Qualquer outro valor (vazio, "true", typo) permanece em report-only: ligar
# bloqueio por engano de digitacao seria pior que nao ligar.
#
# Politica das rotas JSON: `default-src 'none'` mais base-uri / form-action /
# frame-ancestors em 'none'. Uma API que nao renderiza nada nao precisa
# carregar nada, entao nao ha o que calibrar aqui.
#
# O Swagger tem politica propria, ESCOPADA no path dele: o swagger-ui exige
# script e estilo inline, e uma politica unica apertada mataria a
# documentacao. Ver `src/security/http/content-security-policy.ts`.
#
# NAO existe endpoint de relatorio de proposito: seria um POST nao
# autenticado que qualquer pagina consegue fazer o navegador da vitima
# disparar — amplificador de escrita. Durante a calibragem a violacao aparece
# no console do navegador, que e onde ela precisa aparecer.
CSP_REPORT_ONLY="true"

# --- Checagem de senha vazada / HIBP (TRK-012, ASVS 5.0 6.2.12) ----------
# O cadastro exigia 8 caracteres e o Argon2id protege bem a senha guardada,
# mas nada checava a senha contra corpus de vazamento — o controle que mais
# reduz credential stuffing na pratica. Uma senha que atende todo o formato e
# aparece em milhoes de vazamentos e forte no papel e inutil no mundo real.
#
# A SENHA NUNCA SAI DO PROCESSO. O protocolo do Have I Been Pwned e
# k-anonimato: calcula-se o SHA-1 da senha e apenas os 5 PRIMEIROS
# caracteres hexadecimais do hash vao na URL. O servico devolve os sufixos
# daquele prefixo e a comparacao acontece aqui dentro.
#
# AUSENTE (padrao) = LIGADO. Um controle de seguranca que so funciona quando
# alguem lembra de ligar nao e um controle. So o literal "false" desliga
# (null object, mesmo padrao do VAPID e da cifra de corretora). Ambiente de
# teste desliga sozinho: teste nao fala com a internet.
HIBP_ENABLED="true"

# Teto de espera da consulta. Curto de proposito — tem gente parada na tela
# de cadastro. Estourou, o cadastro SEGUE SEM A CHECAGEM (falha aberta) e a
# ocorrencia vai para o log. Bloquear cadastro porque uma API de terceiro
# esta fora troca ganho pequeno de seguranca por indisponibilidade, e daria
# ao atacante um jeito de derrubar o produto derrubando o HIBP.
HIBP_TIMEOUT_MS="2000"
