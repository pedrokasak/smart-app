# Resend
RESEND_API_KEY=""
RESEND_FROM=""
RESEND_AUDIENCE_ID=""

# Frontend
FRONTEND_URL=""

COOLIFY_WEBHOOK_URL=""

# Ranges que o plano atual do brapi serve. Ampliar aqui (sem mexer em código)
# quando o plano pago for contratado — os demais caem para o Yahoo Finance.
