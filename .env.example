# Resend
RESEND_API_KEY=""
RESEND_FROM=""
RESEND_AUDIENCE_ID=""

# Frontend
FRONTEND_URL=""

COOLIFY_WEBHOOK_URL=""

# Ranges que o plano atual do brapi serve. Ampliar aqui (sem mexer em código)
# quando o plano pago for contratado — os demais caem para o Yahoo Finance.
BRAPI_SUPPORTED_RANGES=1d,5d,1mo,3mo

# Secret próprio para os tokens de unsubscribe do digest de e-mail (TRA-17).
# Diferente de JWT_SECRET de propósito: um token de unsubscribe assinado com
# este secret é matematicamente incapaz de validar como access token.
DIGEST_TOKEN_SECRET=""

# URL interna do trackerr-ia (motor de IA/RAG). Deve apontar para a rede
# privada — este serviço não deve receber URL pública.
TRAKKER_IA_URL="http://localhost:8000"

# Segredo compartilhado com o trackerr-ia (TRA-89). O trackerr-ia autentica
# o server por este valor no header `x-service-token` e recusa qualquer
# requisição sem ele. Precisa ser idêntico ao TRACKERR_IA_SERVICE_TOKEN
# configurado lá. Gerar com: openssl rand -hex 32
TRACKERR_IA_SERVICE_TOKEN=""

# --- Stripe product/price mapping por plano canônico (TRA-18) ---
# Consumido pelo `PlanSyncService` (`src/subscription/plan-sync`) e pelo CLI
# `npm run sync:plans`. Um plano sem PRODUCT_ID / PRICE_MONTHLY_ID configurado
# fica sem vínculo mensal ao Stripe (o seed loga TODO — nunca inventa IDs).
# ANNUAL_AMOUNT é o valor cobrado ao ano em BRL e serve para exibição no
# `/subscription`; PRICE_ANNUAL_ID é o preço de fato usado no checkout anual.
STRIPE_PLAN_PRO_PRODUCT_ID=""
STRIPE_PLAN_PRO_PRICE_MONTHLY_ID=""
STRIPE_PLAN_PRO_PRICE_ANNUAL_ID=""
STRIPE_PLAN_PRO_ANNUAL_AMOUNT=""
STRIPE_PLAN_PREMIUM_PRODUCT_ID=""
STRIPE_PLAN_PREMIUM_PRICE_MONTHLY_ID=""
STRIPE_PLAN_PREMIUM_PRICE_ANNUAL_ID=""
STRIPE_PLAN_PREMIUM_ANNUAL_AMOUNT=""
