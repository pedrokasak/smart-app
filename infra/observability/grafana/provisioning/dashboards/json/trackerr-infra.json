{
  "uid": "trackerr-infra",
  "title": "Trackerr · VPS e containers",
  "description": "Recursos da VPS e de cada container (TRA-222).",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "America/Sao_Paulo",
  "tags": [
    "trackerr",
    "TRA-222"
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU por container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "max by (container_name) ({__name__=~\"container_cpu_utilization(_ratio)?\"})",
          "legendFormat": "{{container_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "description": "docker_stats do Collector. Base para calibrar os limites de CPU (TRA-222 F1e)."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Memória por container",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "max by (container_name) (container_memory_usage_total_bytes)",
          "legendFormat": "{{container_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "description": "Base para calibrar os limites de memória (TRA-222 F1e)."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memória do container vs limite",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "max by (container_name) ({__name__=~\"container_memory_percent(_ratio)?\"})",
          "legendFormat": "{{container_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {},
      "description": "Sem limite configurado, o Docker usa a memória do host como teto."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Memória da VPS",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "sum by (state) (system_memory_usage_bytes)",
          "legendFormat": "{{state}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Disco da VPS usado",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 6,
        "h": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(system_filesystem_usage_bytes{state=\"used\"}) / sum(system_filesystem_usage_bytes)",
          "legendFormat": "usado",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Carga (load 1m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "w": 6,
        "h": 8,
        "x": 6,
        "y": 16
      },
      "targets": [
        {
          "expr": "system_cpu_load_average_1m",
          "legendFormat": "load 1m",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Logs com erro",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "w": 12,
        "h": 8,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum by (service_name) (count_over_time({service_name=~\".+\"} |~ \"(?i)error\" [5m]))",
          "legendFormat": "{{service_name}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
